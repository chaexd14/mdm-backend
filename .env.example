DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_local_postgres_password
PORT=3001
RAILS_MAX_THREADS=16
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: DATABASE_URL=postgresql://user:password@host:5432/mdm_backend_production
# Production: SECRET_KEY_BASE=<generate with bundle exec rails secret>
# Local PostgreSQL only; set require for production TLS.
DB_SSLMODE=disable

# Required in production. Generate at least 32 random characters. Never expose in NEXT_PUBLIC_* variables.
MDM_ADMIN_TOKEN=
# Enable locally when testing credential enrollment and dashboard sign-in.
MDM_AUTH_REQUIRED=false

# APK update publication requires a trusted signing certificate fingerprint (SHA-256).
MDM_RELEASE_SIGNER_SHA256=
# Optional overrides; otherwise Android SDK tools are resolved from ANDROID_HOME.
MDM_AAPT2_PATH=
MDM_APKSIGNER_PATH=
# Keep this on private persistent/shared storage, outside public/.
# MDM_RELEASE_STORAGE_ROOT=/var/lib/mdm/releases
